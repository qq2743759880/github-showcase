  "cards": [
    {
      "dot": "cyan",
      "title": "Conditional generation",
      "items": [
        "No metrics: categorical capabilities; no invented chart.",
        "No real media need: video is skipped."
      ]
    },
    {
      "dot": "rose",
      "title": "Failure and recovery",
      "items": [
        "Missing consequential facts block dependent outputs.",
        "After bounded repairs, preserve evidence and stop; never weaken a gate."
      ]
    }
  ]
